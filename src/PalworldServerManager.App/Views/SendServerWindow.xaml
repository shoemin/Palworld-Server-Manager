<Window x:Class="PalworldServerManager.App.Views.SendServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Palworld Server" Height="390" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ServerText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,10,0,6" TextWrapping="Wrap"
                   Text="The server will be exported using the normal .palserver safety path. If it is running, it will be saved and stopped before packaging. The destination must explicitly accept the transfer."/>
        <ComboBox Grid.Row="2" x:Name="PeerCombo" Margin="0,6,0,6"/>
        <Button Grid.Row="3" Content="Refresh Destinations" HorizontalAlignment="Left" Click="Refresh_Click"/>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
            <ProgressBar x:Name="TransferProgress" Height="18" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="SendButton" Content="Send" Click="Send_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

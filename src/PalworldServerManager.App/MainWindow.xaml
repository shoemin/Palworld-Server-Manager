<Window x:Class="PalworldServerManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PalworldServerManager.App.Views"
        Title="Palworld Server Manager" Height="760" Width="1240" MinHeight="640" MinWidth="980">
    <DockPanel>
    <Menu DockPanel.Dock="Top">
        <MenuItem Header="_Help">
            <MenuItem Header="Documentation" Click="OpenDocumentation_Click"/>
            <MenuItem Header="Troubleshooting" Click="OpenTroubleshooting_Click"/>
            <Separator/>
            <MenuItem Header="Report a Bug" Click="OpenReportBug_Click"/>
        </MenuItem>
    </Menu>
    <TabControl Margin="8">
        <TabItem Header="Servers">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Managed Servers" FontSize="18" FontWeight="SemiBold" Margin="4,2,4,8"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Create New Server" Click="CreateServer_Click"/>
                            <Button Content="Find Existing Servers" Click="DiscoverServers_Click"/>
                            <Button Content="Import .palserver Package" Click="ImportPackage_Click"/>
                        </StackPanel>
                        <ListBox x:Name="ServerList" DisplayMemberPath="Name" SelectionChanged="ServerList_SelectionChanged"/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ServerNameText" FontSize="25" FontWeight="SemiBold" Text="Select a server"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Status: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="—"/>
                            <TextBlock Text="    Game Port: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="GamePortText" Text="—"/>
                            <TextBlock Text="    REST Port: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="RestPortText" Text="—"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="2" Margin="0,14,0,4">
                            <Button x:Name="StartButton" Content="Start / Switch To" Click="Start_Click"/>
                            <Button x:Name="StopButton" Content="Stop Safely" Click="Stop_Click"/>
                            <Button x:Name="ForceStopButton" Content="Force Stop" Click="ForceStop_Click"/>
                            <Button Content="Settings" Click="Settings_Click"/>
                            <Button Content="Update / Validate" Click="Update_Click"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="3" Margin="0,2,0,8">
                            <Button Content="Create Backup" Click="Backup_Click"/>
                            <Button Content="Restore Backup" Click="RestoreBackup_Click"/>
                            <Button Content="Export .palserver" Click="Export_Click"/>
                            <Button Content="Send to PC" Click="SendToPc_Click"/>
                            <Button Content="Open Server Folder" Click="OpenFolder_Click"/>
                            <Button Content="Open Logs Folder" Click="OpenLogs_Click"/>
                            <Button Content="Export Diagnostic Bundle" Click="ExportDiagnostics_Click"/>
                            <Button Content="Refresh" Click="Refresh_Click"/>
                        </WrapPanel>

                        <GroupBox Grid.Row="4" Header="Server Details" Margin="0,8,0,8">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Managed path:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InstallPathText" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Imported from:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ImportedFromText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Text="Created:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CreatedText" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,0" TextWrapping="Wrap"
                                           Text="Safety model: imported legacy servers are copied into isolated managed installations; the original source is not modified. LAN transfer transports the same hashed .palserver format and never performs a live save-directory copy."/>
                            </Grid>
                        </GroupBox>

                        <TextBlock Grid.Row="5" x:Name="OperationText" Text="Ready." TextWrapping="Wrap" Padding="4"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Dashboard">
            <views:DashboardView/>
        </TabItem>

        <TabItem Header="LAN &amp; Transfers">
            <views:LanView/>
        </TabItem>
    </TabControl>
    </DockPanel>
</Window>

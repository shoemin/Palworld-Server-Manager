<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <InformationalVersion>0.3.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <Compile Include="..\PalworldServerManager.Client.Shared\*.cs" Link="Security\%(Filename)%(Extension)" />
    <ProjectReference Include="..\PalworldServerManager.Contracts\PalworldServerManager.Contracts.csproj" />
    <ProjectReference Include="..\PalworldServerManager.Client.Platform.Contracts\PalworldServerManager.Client.Platform.Contracts.csproj" />
    <!-- Single Windows composition root (#19 SS1), same pattern as Client.Avalonia's own. -->
    <ProjectReference Include="..\PalworldServerManager.Client.Platform.Windows\PalworldServerManager.Client.Platform.Windows.csproj" />
  </ItemGroup>
</Project>

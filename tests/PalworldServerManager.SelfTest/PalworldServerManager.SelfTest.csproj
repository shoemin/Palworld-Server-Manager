<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <InformationalVersion>0.3.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\PalworldServerManager.Client.Avalonia\Shell\*.cs" Link="Shell\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\design\astra-34\tokens.json" LogicalName="PalworldServerManager.Shell.Tokens.json" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <Compile Include="..\..\src\PalworldServerManager.Client.Shared\*.cs" Link="ClientSecurity\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Core\PalworldServerManager.Core.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Lan\PalworldServerManager.Lan.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PalworldServerManager.Host.Persistence\PalworldServerManager.Host.Persistence.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Host\PalworldServerManager.Host.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Host.Cli\PalworldServerManager.Host.Cli.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Platform.Contracts\PalworldServerManager.Platform.Contracts.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Platform.Windows\PalworldServerManager.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Client.Platform.Contracts\PalworldServerManager.Client.Platform.Contracts.csproj" />
    <ProjectReference Include="..\..\src\PalworldServerManager.Client.Platform.Windows\PalworldServerManager.Client.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PalworldServerManager.Contracts\PalworldServerManager.Contracts.csproj" />
    <None Update="Fixtures\host-*.pb" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\local-security-*.pb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
